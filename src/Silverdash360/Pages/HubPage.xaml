<xbox:XboxApplicationPage x:Class="Silverdash360.Pages.HubPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    xmlns:local="clr-namespace:Silverdash360.Controls"
    Title="Silverdash360">
  <Grid Background="{StaticResource PageBackground}">
    <!-- The theme's wallpaper, darkened so the text over it reads. -->
    <Image x:Name="Wallpaper" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" />
    <Rectangle x:Name="WallpaperShade" Visibility="Collapsed">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#B0000000" Offset="0" />
          <GradientStop Color="#60000000" Offset="0.35" />
          <GradientStop Color="#90000000" Offset="1" />
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Grid Margin="64,36,64,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Logo, the sections, and the profile and clock on the right. -->
      <Grid Height="64">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="silverdash" FontSize="30" Foreground="{StaticResource Silver}" FontWeight="Bold" />
          <TextBlock Text="360" FontSize="30" Foreground="{StaticResource Accent}" FontWeight="Bold" />
          <StackPanel x:Name="Headers" Orientation="Horizontal" Margin="44,0,0,0" VerticalAlignment="Bottom" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock x:Name="GamertagText" FontSize="20" Foreground="White" HorizontalAlignment="Right" />
            <TextBlock x:Name="GamerscoreText" FontSize="16" Foreground="{StaticResource SubText}" HorizontalAlignment="Right" />
          </StackPanel>
          <Grid Width="48" Height="48" Background="{StaticResource Panel}">
            <TextBlock x:Name="GamerInitials" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image x:Name="GamerPicture" Stretch="UniformToFill" />
          </Grid>
          <TextBlock x:Name="ClockText" FontSize="24" Foreground="White" VerticalAlignment="Center" Margin="22,0,0,0" />
        </StackPanel>
      </Grid>

      <ContentControl x:Name="SectionHost" Grid.Row="1" Margin="0,22,0,10"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
        <ContentControl.RenderTransform>
          <TranslateTransform x:Name="SectionSlide" />
        </ContentControl.RenderTransform>
      </ContentControl>

      <Grid Grid.Row="2" Height="34">
        <TextBlock x:Name="StatusText" FontSize="18" Foreground="{StaticResource SubText}" VerticalAlignment="Center"
                   Margin="0,0,420,0" />
        <!-- While the library is read: a bar, and what's being done. -->
        <StackPanel x:Name="ProgressPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
          <Grid x:Name="ProgressTrack" Width="240" Height="6" Background="{StaticResource Panel}" VerticalAlignment="Center">
            <Grid.Clip>
              <RectangleGeometry Rect="0,0,240,6" />
            </Grid.Clip>
            <Rectangle x:Name="ProgressFill" Fill="{StaticResource Accent}" HorizontalAlignment="Left" Width="0">
              <Rectangle.RenderTransform>
                <TranslateTransform x:Name="ProgressSlide" />
              </Rectangle.RenderTransform>
            </Rectangle>
          </Grid>
          <TextBlock x:Name="ProgressText" FontSize="18" Foreground="{StaticResource SubText}" Margin="14,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>
        <local:ButtonLegend x:Name="LegendText" VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </Grid>
  </Grid>
</xbox:XboxApplicationPage>
