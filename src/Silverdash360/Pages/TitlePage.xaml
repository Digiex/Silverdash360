<xbox:XboxApplicationPage x:Class="Silverdash360.Pages.TitlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    xmlns:local="clr-namespace:Silverdash360.Controls"
    Title="Title">
  <Grid Background="{StaticResource PageBackground}">
    <!-- The title's art, faint behind the page. -->
    <Image x:Name="Backdrop" Stretch="UniformToFill" Opacity="0.12" />
    <Grid Margin="64,40,64,28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <Grid x:Name="ArtFrame" Width="300" Height="300">
          <TextBlock x:Name="ArtInitials" FontSize="96" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image x:Name="Art" Stretch="Uniform" />
        </Grid>
        <local:TileGrid x:Name="Actions" Height="300" Margin="0,18,0,0" />
      </StackPanel>

      <Grid Grid.Column="1" Margin="40,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock x:Name="NameText" FontSize="40" Foreground="White" />
          <TextBlock x:Name="InfoText" FontSize="18" Foreground="{StaticResource SubText}" Margin="0,4,0,0" />
          <TextBlock x:Name="StatsText" FontSize="18" Foreground="{StaticResource Accent}" Margin="0,8,0,0" />
          <TextBlock x:Name="DescriptionText" FontSize="18" Foreground="White" TextWrapping="Wrap"
                     MaxHeight="96" Margin="0,12,0,0" />
        </StackPanel>
        <StackPanel x:Name="Tabs" Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,10" />
        <local:TileGrid x:Name="Details" Grid.Row="2" />
      </Grid>

      <Grid Grid.Row="1" Grid.ColumnSpan="2" Height="34">
        <TextBlock x:Name="StatusText" FontSize="18" Foreground="{StaticResource SubText}" VerticalAlignment="Center" />
        <local:ButtonLegend x:Name="LegendText" VerticalAlignment="Center" HorizontalAlignment="Right" Text="A select   B back   LB RB lists" />
      </Grid>
    </Grid>
  </Grid>
</xbox:XboxApplicationPage>
