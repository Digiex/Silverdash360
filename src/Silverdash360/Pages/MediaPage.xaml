<xbox:XboxApplicationPage x:Class="Silverdash360.Pages.MediaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    xmlns:local="clr-namespace:Silverdash360.Controls"
    Title="Media">
  <Grid Background="{StaticResource PageBackground}">
    <Grid Margin="64,40,64,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock x:Name="SourceText" FontSize="26" Foreground="{StaticResource SubText}" />
        <TextBlock x:Name="FolderText" FontSize="36" Foreground="White" Margin="0,4,0,0" />
      </StackPanel>
      <StackPanel x:Name="Filters" Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,14" />
      <local:TileGrid x:Name="Items" Grid.Row="2" />
      <Grid Grid.Row="3" Height="34">
        <TextBlock x:Name="StatusText" FontSize="18" Foreground="{StaticResource SubText}" VerticalAlignment="Center" />
        <local:ButtonLegend VerticalAlignment="Center" HorizontalAlignment="Right" Text="A open   LB RB filter   B back" />
      </Grid>
    </Grid>
  </Grid>
</xbox:XboxApplicationPage>
