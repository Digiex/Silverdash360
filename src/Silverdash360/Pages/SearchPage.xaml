<xbox:XboxApplicationPage x:Class="Silverdash360.Pages.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    xmlns:local="clr-namespace:Silverdash360.Controls"
    Title="Search">
  <Grid Background="{StaticResource PageBackground}">
    <Grid Margin="64,40,64,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="572" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.ColumnSpan="2">
        <TextBlock Text="search" FontSize="26" Foreground="{StaticResource SubText}" />
        <Border Background="{StaticResource Panel}" Height="64" Margin="0,8,0,20" Padding="18,0">
          <Grid>
            <TextBlock x:Name="QueryHint" Text="Type a name, a publisher or a title ID" FontSize="26"
                       Foreground="{StaticResource SubText}" VerticalAlignment="Center" Margin="14,0,0,0" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="QueryText" FontSize="30" Foreground="White" />
              <Rectangle Width="3" Height="32" Fill="{StaticResource Accent}" Margin="3,0,0,0" />
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>

      <local:OnScreenKeyboard x:Name="Keyboard" Grid.Row="1" />
      <local:TileGrid x:Name="Results" Grid.Row="1" Grid.Column="1" Margin="36,0,0,0" />

      <Grid Grid.Row="2" Grid.ColumnSpan="2" Height="34">
        <TextBlock x:Name="CountText" FontSize="18" Foreground="{StaticResource SubText}" VerticalAlignment="Center" />
        <TextBlock FontSize="18" Foreground="{StaticResource SubText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="A type   X delete   Y space   right results   B back" />
      </Grid>
    </Grid>
  </Grid>
</xbox:XboxApplicationPage>
