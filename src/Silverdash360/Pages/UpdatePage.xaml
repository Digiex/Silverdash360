<xbox:XboxApplicationPage x:Class="Silverdash360.Pages.UpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    xmlns:local="clr-namespace:Silverdash360.Controls"
    Title="Update">
  <Grid Background="{StaticResource PageBackground}">
    <Grid Margin="64,40,64,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18">
        <TextBlock FontSize="26" Foreground="{StaticResource SubText}" Text="update" />
        <TextBlock x:Name="NameText" FontSize="36" Foreground="White" Margin="0,4,0,0" />
        <TextBlock x:Name="CurrentText" FontSize="20" Foreground="{StaticResource SubText}" Margin="0,6,0,0" />
      </StackPanel>
      <TextBlock x:Name="NotesText" Grid.Row="1" FontSize="18" Foreground="{StaticResource SubText}" TextWrapping="Wrap" />
      <local:TileGrid x:Name="Actions" Grid.Row="2" Height="236" Margin="0,16,0,0" />
      <Grid Grid.Row="3" Height="34">
        <TextBlock x:Name="StatusText" FontSize="18" Foreground="{StaticResource SubText}" VerticalAlignment="Center"
                   Margin="0,0,280,0" />
        <local:ButtonLegend x:Name="Legend" VerticalAlignment="Center" HorizontalAlignment="Right" Text="A select   B later" />
      </Grid>
    </Grid>
  </Grid>
</xbox:XboxApplicationPage>
