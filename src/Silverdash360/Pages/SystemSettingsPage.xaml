<xbox:XboxApplicationPage x:Class="Silverdash360.Pages.SystemSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    xmlns:local="clr-namespace:Silverdash360.Controls"
    Title="System settings">
  <Grid Background="{StaticResource PageBackground}">
    <Grid Margin="64,40,64,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,24">
        <TextBlock x:Name="TitleText" FontSize="40" Foreground="White" Text="System settings" />
        <TextBlock x:Name="IntroText" FontSize="20" Foreground="{StaticResource SubText}" TextWrapping="Wrap" Margin="0,12,0,0" />
      </StackPanel>
      <local:TileGrid x:Name="Rows" Grid.Row="1" />
      <Grid Grid.Row="2" Height="34">
        <local:ButtonLegend x:Name="Legend" VerticalAlignment="Center" HorizontalAlignment="Right" Text="A change   B back" />
      </Grid>
    </Grid>
  </Grid>
</xbox:XboxApplicationPage>
