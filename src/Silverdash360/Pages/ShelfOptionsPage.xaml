<xbox:XboxApplicationPage x:Class="Silverdash360.Pages.ShelfOptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    xmlns:local="clr-namespace:Silverdash360.Controls"
    Title="Filter">
  <Grid Background="{StaticResource PageBackground}">
    <Grid Margin="64,40,64,28">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Margin="0,0,0,18">
        <TextBlock x:Name="ShelfText" FontSize="26" Foreground="{StaticResource SubText}" />
        <TextBlock x:Name="CountText" FontSize="36" Foreground="White" Margin="0,4,0,0" />
      </StackPanel>
      <local:TileGrid x:Name="Items" Grid.Row="1" />
      <Grid Grid.Row="2" Height="34">
        <TextBlock FontSize="18" Foreground="{StaticResource SubText}" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Text="A change   X back a step   B done" />
      </Grid>
    </Grid>
  </Grid>
</xbox:XboxApplicationPage>
