<xbox:XboxApplicationPage x:Class="Silverdash360.Pages.PlayerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:xbox="clr-namespace:Microsoft.Xbox.Controls;assembly=Microsoft.Xbox"
    Title="Player">
  <Grid Background="Black">
    <!-- What's playing: big for music, a corner for video that fades out. -->
    <StackPanel x:Name="Info" Margin="64,40" VerticalAlignment="Top">
      <TextBlock x:Name="KindText" FontSize="22" Foreground="{StaticResource SubText}" />
      <TextBlock x:Name="TitleText" FontSize="40" Foreground="White" TextWrapping="Wrap" Margin="0,6,0,0" />
      <TextBlock x:Name="ArtistText" FontSize="26" Foreground="{StaticResource SubText}" Margin="0,6,0,0" />
      <TextBlock x:Name="QueueText" FontSize="20" Foreground="{StaticResource SubText}" Margin="0,18,0,0" />
      <TextBlock x:Name="ErrorText" FontSize="22" Foreground="#FFFF8A80" TextWrapping="Wrap" Margin="0,18,0,0" />
    </StackPanel>
    <!-- The console's playback chrome: transport bar, timeline, controller handling. -->
    <xbox:MediaTransport x:Name="Transport" Back="Transport_Back">
      <MediaElement x:Name="Player" AutoPlay="True" />
    </xbox:MediaTransport>
  </Grid>
</xbox:XboxApplicationPage>
