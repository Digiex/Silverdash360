    <Page Include="Pages\SearchPage.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Compile Include="Pages\SearchPage.xaml.cs"><DependentUpon>Pages\SearchPage.xaml</DependentUpon></Compile>
    <Page Include="Pages\StoragePage.xaml"><Generator>MSBuild:Compile</Generator></Page>
    <Compile Include="Pages\StoragePage.xaml.cs"><DependentUpon>Pages\StoragePage.xaml</DependentUpon></Compile>
  </ItemGroup>
